# 若可 Ruoke 环境变量示例文件
# ─────────────────────────────────────────────────────────
# 作用：告诉开发者/新机器本机要填哪些密钥。本文件进 git（只有名字没真值）。
# 真实密钥文件 .env 不进 git（已在 .gitignore 排除），由你本机自行创建。
#
# 用法：
#   1. 复制本文件为 .env：复制一份改名 .env，填入真值
#   2. 启动前 main.dart 用 flutter_dotenv 加载 .env
#   3. 上线上架前，密钥需移到 flutter_secure_storage 或后端，不再依赖 .env（见技术方案 A/C）
#
# 安全提醒：
#   - 真实 .env 绝不进 git、绝不上传远程仓库、绝不外发
#   - 若不小心把真 .env 提交了，立即在平台作废重发密钥并用 git 历史清除
#   - 只填值，不要带引号注释在同行（dotenv 解析保守，避免踩坑）
# ─────────────────────────────────────────────────────────

# AI 商业 API 密钥（按 function 自选模型，见技术方案 C §2.2）
# 智谱 GLM（讲解 explain 默认推荐）
AI_ZHIPU_KEY=

# DeepSeek
AI_DEEPSEEK_KEY=

# OpenAI（可选，若你想用 GPT 系）
AI_OPENAI_KEY=

# 其他 AI provider 按需自行加，命名约定：AI_<PROVIDER>_KEY=

# ─── 以下为可选/未来项（MVP 暂不需要，留位）───

# 对象存储访问凭证（V2 上云备份加密包用，MVP 不启用）
CLOUD_ENDPOINT=
CLOUD_BUCKET=
CLOUD_ACCESS_KEY=
CLOUD_SECRET_KEY=
